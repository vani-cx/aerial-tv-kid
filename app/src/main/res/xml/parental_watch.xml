<?xml version="1.0" encoding="utf-8"?>
<!--
  The parental watchdog (parental/WatchService.kt).

  Only window changes are asked for, and canRetrieveWindowContent is off: the service needs to know
  which app is in front to count its time, and nothing about what it shows. No text, no view tree,
  no keys.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/kid_service_description" />
